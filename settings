pluginManagement {
    repositories {
        gradlePluginPortal()
        google()
        mavenCentral()
    }
}
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.PREFER_SETTINGS)
    repositories {
        google()
        mavenCentral()
        // Xposed API (de.robv.android.xposed:api)
        maven { url 'https://api.xposed.info/' }
        // fallback mirror for the Xposed api artifact
        maven { url 'https://s01.oss.sonatype.org/content/repositories/releases/' }
    }
}
rootProject.name = "8ubah-android"
include ':app'
